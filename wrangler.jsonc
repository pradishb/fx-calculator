// Cloudflare Worker that serves the app as static files at calc.pradish.com.np.
// Deploy with `npx wrangler deploy`. Files left out are listed in .assetsignore.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "money-calc",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "."
  },
  "routes": [{ "pattern": "calc.pradish.com.np", "custom_domain": true }],
  "workers_dev": false
}
